{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.local/schemas/adapter-result.schema.json",
  "title": "STUDIO-007F normalized adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "request_id", "work_order_id", "attempt_number", "adapter_type", "capability_id", "correlation_id", "artifact_identity", "status", "output_references", "evidence_references", "usage_counters", "error_class", "handoff_reference", "completed_at"],
  "allOf": [
    {"if": {"properties": {"status": {"const": "SUCCESS"}}}, "then": {"properties": {"error_class": {"const": "NONE"}, "output_references": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "REFUSED"}}}, "then": {"properties": {"error_class": {"const": "REFUSAL"}, "output_references": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "TIMEOUT"}}}, "then": {"properties": {"error_class": {"const": "TIMEOUT"}, "output_references": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "FAILURE"}}}, "then": {"properties": {"error_class": {"enum": ["MALFORMED_OUTPUT", "ADAPTER_FAILURE"]}, "output_references": {"maxItems": 0}}}}
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "work_order_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "adapter_type": {"enum": ["MANUAL", "FAKE"]},
    "capability_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "artifact_identity": {"$ref": "#/$defs/artifact"},
    "status": {"enum": ["SUCCESS", "REFUSED", "TIMEOUT", "FAILURE"]},
    "output_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(artifact|evidence|gate|trace|budget|handoff|fixture)://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"}},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(artifact|evidence|gate|trace|budget|handoff|fixture)://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"}},
    "usage_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_references", "output_references", "output_bytes", "monetary_minor_units"],
      "properties": {
        "input_references": {"type": "integer", "minimum": 0},
        "output_references": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "monetary_minor_units": {"const": 0}
      }
    },
    "error_class": {"enum": ["NONE", "REFUSAL", "TIMEOUT", "MALFORMED_OUTPUT", "ADAPTER_FAILURE"]},
    "handoff_reference": {"type": ["string", "null"], "pattern": "^handoff://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"},
    "completed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "artifact_digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
