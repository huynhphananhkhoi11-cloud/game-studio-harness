{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.local/schemas/quota-budget.schema.json",
  "title": "STUDIO-007E zero-cost quota budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quota_id", "work_order_id", "attempt_number", "cost_class", "monetary_budget_minor_units", "monetary_spend_minor_units", "max_attempts", "max_elapsed_seconds", "max_changed_paths", "max_output_bytes", "started_at", "evaluated_at", "observed_attempts", "observed_changed_paths", "observed_output_bytes", "owner_amendments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "quota_id": {"type": "string", "minLength": 1},
    "work_order_id": {"type": "string", "minLength": 1},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "cost_class": {"const": "ZERO_COST"},
    "monetary_budget_minor_units": {"const": 0},
    "monetary_spend_minor_units": {"const": 0},
    "max_attempts": {"const": 3},
    "max_elapsed_seconds": {"const": 7200},
    "max_changed_paths": {"const": 25},
    "max_output_bytes": {"const": 2097152},
    "started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "evaluated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "observed_attempts": {"type": "integer", "minimum": 1},
    "observed_changed_paths": {"type": "integer", "minimum": 0},
    "observed_output_bytes": {"type": "integer", "minimum": 0},
    "owner_amendments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["amendment_id", "limit_name", "prior_value", "new_value", "approved_by", "approved_role", "evidence_digest", "work_order_id", "attempt_number", "decided_at", "expires_at", "reason"], "properties": {"amendment_id": {"type": "string", "minLength": 1}, "limit_name": {"enum": ["max_elapsed_seconds", "max_changed_paths", "max_output_bytes"]}, "prior_value": {"type": "integer", "minimum": 1}, "new_value": {"type": "integer", "minimum": 1}, "approved_by": {"type": "string", "minLength": 1}, "approved_role": {"const": "STUDIO_OWNER"}, "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "work_order_id": {"type": "string", "minLength": 1}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "decided_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}}}}
  }
}
