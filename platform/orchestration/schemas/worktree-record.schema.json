{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worktree-record.schema.json",
  "title": "STUDIO-007C worktree evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worktree_id", "branch", "base_commit", "current_commit", "permitted_paths", "status", "evidence_references", "observed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "worktree_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "permitted_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
