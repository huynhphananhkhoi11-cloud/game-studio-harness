{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-studio-harness://platform/orchestration/work-order.schema.json",
  "title": "STUDIO-007A Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_order_id", "producer_id", "requesting_unit",
    "project_id", "objective", "permitted_paths", "prohibited_actions",
    "capability_tags", "input_references", "expected_output_references",
    "acceptance_gates", "priority", "budget_ceiling", "dependency_ids",
    "attempt", "state", "owner_gate_required", "created_at", "updated_at",
    "last_event_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "work_order_id": {"type": "string", "pattern": "^WO-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "producer_id": {"type": "string", "minLength": 1},
    "requesting_unit": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "permitted_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capability_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_output_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "budget_ceiling": {"const": 0},
    "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attempt": {"type": "integer", "minimum": 1},
    "state": {"enum": ["DRAFT", "READY", "CLAIMABLE", "CLAIMED", "BLOCKED", "QA_PENDING", "OWNER_PENDING", "DONE", "CANCELLED"]},
    "owner_gate_required": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_event_id": {"type": "string", "minLength": 1}
  }
}
