{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.local/schemas/adapter-request.schema.json",
  "title": "STUDIO-007F normalized adapter request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "work_order_id", "attempt_number", "adapter_type", "capability_id", "correlation_id", "artifact_identity", "input_references", "gate_evidence_references", "trace_reference", "budget_reference", "created_at", "as_of"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "work_order_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "adapter_type": {"enum": ["MANUAL", "FAKE"]},
    "capability_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "artifact_identity": {"$ref": "#/$defs/artifact"},
    "input_references": {"$ref": "#/$defs/references"},
    "gate_evidence_references": {"$ref": "#/$defs/references"},
    "trace_reference": {"type": "string", "pattern": "^trace://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"},
    "budget_reference": {"type": "string", "pattern": "^budget://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "as_of": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "artifact_digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(artifact|evidence|gate|trace|budget|handoff|fixture)://[A-Za-z0-9][A-Za-z0-9._:/-]{0,510}$"}
    }
  }
}
