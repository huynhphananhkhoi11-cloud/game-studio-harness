{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writer-claim.schema.json",
  "title": "STUDIO-007C immutable writer claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claim_id", "work_order_id", "work_order_digest",
    "executor_id", "branch", "worktree_id", "base_commit", "permitted_paths",
    "issued_at", "expires_at", "status", "lease_revision", "prior_claim_id",
    "prior_claim_digest", "evidence_references"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "claim_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "work_order_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "work_order_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executor_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "branch": {"type": "string", "minLength": 1},
    "worktree_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "permitted_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["CLAIMED", "TRANSFER_PENDING", "RELEASED", "UNKNOWN"]},
    "lease_revision": {"type": "integer", "minimum": 1},
    "prior_claim_id": {"type": ["string", "null"]},
    "prior_claim_digest": {"type": ["string", "null"]},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
