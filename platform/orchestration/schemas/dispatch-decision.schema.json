{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-studio-harness://platform/orchestration/dispatch-decision.schema.json",
  "title": "STUDIO-007B Manual Dispatch Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "work_order_id", "work_order_digest",
    "selected_executor_id", "required_capability_tags", "required_input_types",
    "required_output_types", "considered_alternatives", "dispatcher_id",
    "dispatcher_role", "reason", "evidence_references", "decided_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^DSP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "work_order_id": {"type": "string", "pattern": "^WO-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "work_order_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selected_executor_id": {"type": "string", "minLength": 1},
    "required_capability_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_input_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "required_output_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "considered_alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executor_id", "outcome", "reason"],
        "properties": {
          "executor_id": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["CONSIDERED_NOT_SELECTED", "INELIGIBLE", "UNAVAILABLE"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "dispatcher_id": {"type": "string", "minLength": 1},
    "dispatcher_role": {"const": "STUDIO_OWNER"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decided_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
