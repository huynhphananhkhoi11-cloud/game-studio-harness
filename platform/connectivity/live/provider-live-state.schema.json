{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game://platform/connectivity/live/provider-live-state.schema.json",
  "title": "GAME Provider Live State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "live_state_id",
    "provider_profile_id",
    "provider_child_id",
    "offline_merge_ref",
    "offline_qa_ref",
    "offline_review_ref",
    "offline_owner_merge_ref",
    "v_contract_ref",
    "connected_validation_ref",
    "routing_authority_ref",
    "state",
    "allowed_data_classifications",
    "money_ceiling",
    "paused_at",
    "revoked_at",
    "as_of",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "live_state_id": {
      "type": "string",
      "pattern": "^provider-live-state:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_profile_id": {
      "type": "string",
      "pattern": "^provider-profile:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_child_id": {
      "type": "string",
      "pattern": "^STUDIO-009P-[A-Z0-9][A-Z0-9-]{0,31}$"
    },
    "offline_merge_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "offline_qa_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "offline_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "offline_owner_merge_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "v_contract_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "connected_validation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing_authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "DISABLED",
        "LIVE_VALIDATION_READY",
        "LIVE_VALIDATED",
        "LIVE_SHADOW_WORKER",
        "LIVE_BOUNDED_WORKER",
        "ROUTING_ELIGIBLE",
        "PAUSED",
        "REVOKED"
      ]
    },
    "allowed_data_classifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "RESTRICTED"
        ]
      }
    },
    "money_ceiling": {
      "const": 0
    },
    "paused_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
