{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-record.schema.json",
  "title": "STUDIO-009B Repository Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "host",
    "owner",
    "name",
    "canonical_url",
    "default_branch",
    "registration_revision",
    "access_tier",
    "allowed_paths",
    "denied_paths",
    "allowed_branch_namespace",
    "allowed_classifications",
    "instruction_authority_paths",
    "auth_profile_ref",
    "owner_approval_ref",
    "boundary_digest",
    "threat_assessment_digest",
    "registry_version_ref",
    "status",
    "kill_switch_ref",
    "read_only_downgrade_ref",
    "as_of",
    "expires_at",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "host": {
      "const": "github.com"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,100}$"
    },
    "canonical_url": {
      "type": "string",
      "pattern": "^https://github[.]com/[a-z0-9-]+/[a-z0-9._-]+$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "registration_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "access_tier": {
      "enum": [
        "READ_ONLY",
        "BRANCH_WRITE",
        "PR_WRITE"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "denied_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "allowed_branch_namespace": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/$"
        }
      ]
    },
    "allowed_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "RESTRICTED"
        ]
      }
    },
    "instruction_authority_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "auth_profile_ref": {
      "type": "string"
    },
    "owner_approval_ref": {
      "type": "string"
    },
    "boundary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "threat_assessment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registry_version_ref": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DISABLED",
        "READ_ONLY_ACTIVE",
        "WRITE_ACTIVE"
      ]
    },
    "kill_switch_ref": {
      "type": "string"
    },
    "read_only_downgrade_ref": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
