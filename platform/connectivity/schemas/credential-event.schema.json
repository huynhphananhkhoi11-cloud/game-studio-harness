{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_event_id",
    "credential_profile_id",
    "profile_digest",
    "credential_lease_id",
    "action",
    "owner_approval_ref",
    "control_ref",
    "as_of",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "credential_event_id": {
      "type": "string",
      "pattern": "^credential-event:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "credential_profile_id": {
      "type": "string",
      "pattern": "^credential-profile:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "credential_lease_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^credential-lease:[0-9a-f]{32}$"
        }
      ]
    },
    "action": {
      "enum": [
        "DISABLE",
        "ENABLE_ELIGIBLE",
        "REVOKE",
        "ROTATION_REQUIRED",
        "LEASE_ISSUED",
        "LEASE_EXPIRED"
      ]
    },
    "owner_approval_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "control_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
