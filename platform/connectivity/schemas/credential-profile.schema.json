{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_profile_id",
    "auth_profile_ref",
    "subject_type",
    "subject_ref",
    "credential_class",
    "auth_scheme_ref",
    "secret_store_ref",
    "secret_locator_ref",
    "allowed_capabilities",
    "allowed_purposes",
    "repository_record_digest",
    "owner_approval_ref",
    "boundary_digest",
    "gate_ref",
    "trace_ref",
    "kill_switch_ref",
    "lifecycle_ref",
    "status",
    "not_before",
    "expires_at",
    "rotation_deadline",
    "max_lease_seconds",
    "as_of",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "credential_profile_id": {
      "type": "string",
      "pattern": "^credential-profile:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "auth_profile_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "subject_type": {
      "enum": [
        "REPOSITORY",
        "PROVIDER",
        "SERVICE"
      ]
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "credential_class": {
      "enum": [
        "REPOSITORY_AUTH",
        "PROVIDER_AUTH",
        "SERVICE_AUTH"
      ]
    },
    "auth_scheme_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "secret_store_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "secret_locator_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "allowed_purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "repository_record_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "owner_approval_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "boundary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "trace_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "kill_switch_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "lifecycle_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "status": {
      "enum": [
        "DISABLED",
        "ACTIVE",
        "REVOKED",
        "ROTATION_REQUIRED"
      ]
    },
    "not_before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rotation_deadline": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "max_lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
