{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.local/schemas/studio-009d-provider-model-profile.schema.json",
  "title": "STUDIO-009D provider model profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_model_profile_id",
    "provider_profile_id",
    "provider_profile_digest",
    "child_contract_id",
    "child_contract_digest",
    "model_identity_ref",
    "model_version_policy_ref",
    "allowed_data_classifications",
    "max_request_bytes",
    "max_output_bytes",
    "owner_approval_ref",
    "status",
    "not_before",
    "expires_at",
    "as_of",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider_model_profile_id": {
      "type": "string",
      "pattern": "^provider-model:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_profile_id": {
      "type": "string",
      "pattern": "^provider-profile:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "child_contract_id": {
      "type": "string",
      "pattern": "^STUDIO-009P-[A-Z0-9][A-Z0-9-]{0,31}$"
    },
    "child_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_identity_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "model_version_policy_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "allowed_data_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "RESTRICTED"
        ]
      }
    },
    "max_request_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "owner_approval_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "status": {
      "enum": [
        "DECLARED",
        "ELIGIBLE",
        "PAUSED",
        "REVOKED"
      ]
    },
    "not_before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
