{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.local/schemas/studio-009d-provider-onboarding-event.schema.json",
  "title": "STUDIO-009D provider onboarding event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_onboarding_event_id",
    "provider_profile_id",
    "provider_profile_digest",
    "child_contract_id",
    "child_contract_digest",
    "action",
    "owner_approval_ref",
    "control_ref",
    "as_of",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider_onboarding_event_id": {
      "type": "string",
      "pattern": "^provider-event:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_profile_id": {
      "type": "string",
      "pattern": "^provider-profile:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "provider_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "child_contract_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^STUDIO-009P-[A-Z0-9][A-Z0-9-]{0,31}$"
    },
    "child_contract_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "action": {
      "enum": [
        "REGISTER_CANDIDATE",
        "MARK_ELIGIBLE",
        "PAUSE",
        "REVOKE",
        "EXPIRE"
      ]
    },
    "owner_approval_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "control_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9._/-]{1,160}$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
